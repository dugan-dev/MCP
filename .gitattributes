# Preserve imported source and byte-oriented fixture provenance on every checkout.
* -text
* whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Exact upstream fixtures: trailing line breaks are intentional source bytes.
tests/mcp/fixtures/mcp-2026-07-28.schema.json whitespace=-blank-at-eof,cr-at-eol
tests/mcp/fuzz/corpus/sse/event.txt whitespace=-blank-at-eof,cr-at-eol
