@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(NOT TARGET UniMemory::UniMemory)
    find_dependency(UniMemory 0.0.1...<0.1.0 CONFIG HINTS "${CMAKE_CURRENT_LIST_DIR}/../UniMemory")
endif()
set(MCP_MEMORY_BACKEND "@UNIMEMORY_BACKEND@")
set(MCP_MEMORY_STATISTICS "@UNIMEMORY_STATISTICS@")
set(MCP_MEMORY_CHECKS_POLICY "@UNIMEMORY_CHECKS@")
get_target_property(_mcp_memory_type UniMemory::UniMemory TYPE)
get_target_property(_mcp_memory_version UniMemory::UniMemory UNIMEMORY_VERSION)
if(NOT _mcp_memory_type STREQUAL "INTERFACE_LIBRARY" OR
   NOT _mcp_memory_version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$" OR
   _mcp_memory_version VERSION_LESS 0.0.1 OR NOT _mcp_memory_version VERSION_LESS 0.1.0)
    set(MCP_FOUND FALSE)
    set(MCP_NOT_FOUND_MESSAGE "MCP requires official fixed-profile header-only UniMemory >=0.0.1 and <0.1.0")
    return()
endif()
foreach(_mcp_property IN ITEMS BACKEND STATISTICS CHECKS_POLICY)
    get_target_property(_mcp_value UniMemory::UniMemory UNIMEMORY_${_mcp_property})
    if(NOT _mcp_value STREQUAL MCP_MEMORY_${_mcp_property})
        set(MCP_FOUND FALSE)
        set(MCP_NOT_FOUND_MESSAGE "MCP and UniMemory ${_mcp_property} profiles differ")
        return()
    endif()
endforeach()
find_dependency(nlohmann_json @MCP_JSON_VERSION@ EXACT CONFIG)
find_dependency(CURL 7.85)
find_dependency(OpenSSL 3)
find_dependency(Boost 1.91 CONFIG COMPONENTS asio beast process)
get_target_property(_mcp_process_definitions Boost::process INTERFACE_COMPILE_DEFINITIONS)
if(NOT "BOOST_PROCESS_USE_STD_FS" IN_LIST _mcp_process_definitions)
    set(MCP_FOUND FALSE)
    set(MCP_NOT_FOUND_MESSAGE "MCP requires Boost.Process built with BOOST_PROCESS_USE_STD_FS=ON. Use the MCP vcpkg overlay or rebuild Boost.Process with that official CMake option; defining the macro only in the consumer would mismatch the library ABI.")
    return()
endif()
unset(_mcp_process_definitions)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/MCPTargets.cmake")
check_required_components(MCP)
