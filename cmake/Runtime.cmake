if(WIN32 AND (BUILD_SHARED_LIBS OR TARGET exe_cli))
    include("${CMAKE_CURRENT_LIST_DIR}/RuntimePaths.cmake")
    set(MCP_RUNTIME_PATHS_FILE "${CMAKE_CURRENT_LIST_DIR}/RuntimePaths.cmake")
    # Explicit roots also traverse DLLs built by this project. Automatic target
    # dependency collection excludes them and can miss their imported DLLs.
    set(MCP_RUNTIME_EXECUTABLES "")
    if(TARGET exe_cli)
        string(APPEND MCP_RUNTIME_EXECUTABLES " \"$<TARGET_FILE:exe_cli>\"")
    endif()
    set(MCP_RUNTIME_LIBRARIES "")
    set(MCP_RUNTIME_LICENSE_FILES "" CACHE STRING "Additional license files for redistributed runtime DLLs")
    set(MCP_RUNTIME_LICENSE_ARGUMENTS "")
    foreach(runtime_license IN LISTS MCP_RUNTIME_LICENSE_FILES)
        string(APPEND MCP_RUNTIME_LICENSE_ARGUMENTS " \"${runtime_license}\"")
    endforeach()
    file(TO_CMAKE_PATH "$ENV{SystemRoot}" MCP_SYSTEM_ROOT)
    string(TOLOWER "${MCP_SYSTEM_ROOT}" MCP_SYSTEM_ROOT_LOWER)
    mcp_runtime_search_directories(runtime_directories)
    # UniMemory is an interface target; its selected SDK's runtime directories
    # are collected above, and it has no target file or DLL of its own.
    foreach(runtime_target IN ITEMS lib_mcp)
        if(TARGET ${runtime_target})
            get_target_property(runtime_type ${runtime_target} TYPE)
            if(runtime_type STREQUAL "SHARED_LIBRARY")
                string(APPEND MCP_RUNTIME_LIBRARIES " \"$<TARGET_FILE:${runtime_target}>\"")
            endif()
            if(runtime_type MATCHES "^(STATIC|SHARED|MODULE|UNKNOWN)_LIBRARY$")
                list(APPEND runtime_directories "$<TARGET_FILE_DIR:${runtime_target}>")
            endif()
        endif()
    endforeach()
    set(MCP_RUNTIME_DIRECTORIES "")
    foreach(runtime_directory IN LISTS runtime_directories)
        string(APPEND MCP_RUNTIME_DIRECTORIES " \"${runtime_directory}\"")
    endforeach()
    configure_file("${CMAKE_CURRENT_LIST_DIR}/InstallRuntime.cmake.in"
        "${CMAKE_CURRENT_BINARY_DIR}/install-runtime.in.cmake" @ONLY)
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/install-runtime-$<CONFIG>.cmake"
        INPUT "${CMAKE_CURRENT_BINARY_DIR}/install-runtime.in.cmake")
    install(SCRIPT "${CMAKE_CURRENT_BINARY_DIR}/install-runtime-$<CONFIG>.cmake")
endif()
