find_package(nlohmann_json 3.11 CONFIG REQUIRED)
if(NOT nlohmann_json_VERSION)
    message(FATAL_ERROR "nlohmann/json must report its version for the exported C++ ABI")
endif()
set_property(GLOBAL PROPERTY MCP_JSON_VERSION "${nlohmann_json_VERSION}")
find_package(CURL 7.85 REQUIRED)
find_package(OpenSSL 3 REQUIRED)
find_package(Boost 1.91 CONFIG REQUIRED COMPONENTS asio beast process)
get_target_property(_mcp_process_definitions Boost::process INTERFACE_COMPILE_DEFINITIONS)
if(NOT "BOOST_PROCESS_USE_STD_FS" IN_LIST _mcp_process_definitions)
    message(FATAL_ERROR "MCP requires Boost.Process built with BOOST_PROCESS_USE_STD_FS=ON. Use this project's vcpkg overlay or rebuild Boost.Process with that official CMake option; defining the macro only in MCP would mismatch the library ABI.")
endif()
unset(_mcp_process_definitions)
find_package(Threads REQUIRED)
find_package(jsoncons CONFIG QUIET)
if(NOT TARGET jsoncons::jsoncons)
    find_path(MCP_JSONCONS_INCLUDE_DIR jsoncons_ext/jsonschema/jsonschema.hpp REQUIRED)
endif()
add_library(lib_mcp src/mcp/json.cpp src/mcp/protocol.cpp src/mcp/schema.cpp src/mcp/server.cpp src/mcp/client.cpp
    src/mcp/sse.cpp src/mcp/notification.cpp src/mcp/http_headers.cpp src/mcp/http_client.cpp src/mcp/http_server.cpp src/mcp/stdio.cpp src/mcp/auth.cpp src/mcp/features.cpp src/mcp/extensions.cpp)
set_target_properties(lib_mcp PROPERTIES OUTPUT_NAME MCP FOLDER "Libraries")
add_library(MCP::MCP ALIAS lib_mcp)
target_compile_features(lib_mcp PUBLIC cxx_std_20)
target_include_directories(lib_mcp PUBLIC $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}> PRIVATE ${PROJECT_SOURCE_DIR}/src/mcp ${MCP_JSONCONS_INCLUDE_DIR})
target_link_libraries(lib_mcp PUBLIC UniMemory::UniMemory nlohmann_json::nlohmann_json
    PRIVATE CURL::libcurl OpenSSL::SSL OpenSSL::Crypto Boost::asio Boost::beast Boost::process Threads::Threads)
if(TARGET jsoncons::jsoncons)
    get_target_property(MCP_JSONCONS_DIRS jsoncons::jsoncons INTERFACE_INCLUDE_DIRECTORIES)
    target_include_directories(lib_mcp PRIVATE ${MCP_JSONCONS_DIRS})
endif()
set_target_properties(lib_mcp PROPERTIES EXPORT_NAME MCP CXX_EXTENSIONS OFF POSITION_INDEPENDENT_CODE ON
    WINDOWS_EXPORT_ALL_SYMBOLS ON DEBUG_POSTFIX d)
if(WIN32 AND BUILD_SHARED_LIBS)
    add_custom_command(TARGET lib_mcp POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different
            $<TARGET_RUNTIME_DLLS:lib_mcp> $<TARGET_FILE_DIR:lib_mcp>
        COMMAND_EXPAND_LISTS)
endif()
if(MSVC)
    target_compile_options(lib_mcp PRIVATE /W4 /permissive- /utf-8 /bigobj)
    target_compile_definitions(lib_mcp PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN _WIN32_WINNT=0x0601)
else()
    target_compile_options(lib_mcp PRIVATE -Wall -Wextra -Wpedantic)
endif()
if(WIN32)
    target_link_libraries(lib_mcp PRIVATE ws2_32 bcrypt)
endif()
if(UNIX AND NOT DEFINED CMAKE_INSTALL_RPATH)
    if(APPLE)
        set(MCP_INSTALL_ORIGIN "@loader_path")
    else()
        set(MCP_INSTALL_ORIGIN "$ORIGIN")
    endif()
    set_target_properties(lib_mcp PROPERTIES EXPORT_NAME MCP INSTALL_RPATH "${MCP_INSTALL_ORIGIN}")
endif()
if(MCP_BUILD_FUZZERS)
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang" OR MSVC)
        message(FATAL_ERROR "MCP_BUILD_FUZZERS requires Clang with libFuzzer")
    endif()
    target_compile_options(lib_mcp PRIVATE -fsanitize=fuzzer-no-link)
    # Ordinary examples and installed consumers need the instrumentation runtime
    # too; only the fuzz entry points should receive libFuzzer's main function.
    target_link_options(lib_mcp PUBLIC -fsanitize=fuzzer-no-link)
    foreach(fuzzer IN ITEMS protocol sse)
        add_executable(test_fuzz_${fuzzer} tests/mcp/fuzz/${fuzzer}.cpp)
        set_target_properties(test_fuzz_${fuzzer} PROPERTIES OUTPUT_NAME mcp_fuzz_${fuzzer} FOLDER "Tests")
        target_link_libraries(test_fuzz_${fuzzer} PRIVATE MCP::MCP)
        target_compile_options(test_fuzz_${fuzzer} PRIVATE -fsanitize=fuzzer)
        target_link_options(test_fuzz_${fuzzer} PRIVATE -fsanitize=fuzzer)
    endforeach()
endif()
install(TARGETS lib_mcp EXPORT MCPTargets ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR}
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR} RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
install(DIRECTORY include/mcp DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
install(EXPORT MCPTargets NAMESPACE MCP:: DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/MCP)
