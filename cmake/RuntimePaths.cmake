include_guard(GLOBAL)

function(mcp_runtime_system_root_regex output system_root)
    file(TO_CMAKE_PATH "${system_root}" root)
    string(TOLOWER "${root}" root)
    string(REGEX REPLACE [[([][+.*()^$?|\\])]] [[\\\1]] root "${root}")
    string(REGEX MATCHALL "[a-z]" letters "${root}")
    list(REMOVE_DUPLICATES letters)
    foreach(letter IN LISTS letters)
        string(TOUPPER "${letter}" upper)
        string(REPLACE "${letter}" "[${letter}${upper}]" root "${root}")
    endforeach()
    # GET_RUNTIME_DEPENDENCIES can return mixed native/forward separators,
    # including C:\\WINDOWS\\system32/kernel32.dll on native Windows builds.
    set(separator [=[[/\\]]=])
    string(REPLACE "/" "${separator}" root "${root}")
    set(${output} "^${root}${separator}" PARENT_SCOPE)
endfunction()

# Imported targets may be directory scoped, and UNKNOWN IMPORTED libraries do
# not describe their companion DLLs to TARGET_RUNTIME_DLLS.
function(mcp_runtime_search_directories output)
    get_property(directories GLOBAL PROPERTY MCP_RUNTIME_SEARCH_DIRECTORIES)
    get_property(licenses GLOBAL PROPERTY MCP_RUNTIME_DEPENDENCY_LICENSES)
    set(configurations ${CMAKE_CONFIGURATION_TYPES})
    if(NOT configurations)
        set(configurations "${CMAKE_BUILD_TYPE}")
    endif()
    if(NOT configurations)
        set(configurations NOCONFIG)
    endif()
    set(directory "${CMAKE_CURRENT_SOURCE_DIR}")
    set(imported_libraries "")
    while(directory)
        get_property(imports DIRECTORY "${directory}" PROPERTY IMPORTED_TARGETS)
        foreach(target IN LISTS imports)
            get_target_property(kind ${target} TYPE)
            if(NOT kind MATCHES "^(STATIC|SHARED|MODULE|UNKNOWN)_LIBRARY$")
                continue()
            endif()
            list(APPEND imported_libraries ${target})
        endforeach()
        get_property(directory DIRECTORY "${directory}" PROPERTY PARENT_DIRECTORY)
    endwhile()
    list(REMOVE_DUPLICATES imported_libraries)

    # A host can finish add_subdirectory(UniMemory) before our staging hook
    # exists. Its private allocator targets are then invisible here, even though
    # the source UniMemory target is public. Read its existing 0.0.1 discovery
    # results in the owning directory for the target's selected backend. The
    # source-version fallback does not change its interface profile or options.
    set(memory_jemalloc_release "")
    set(memory_jemalloc_debug "")
    set(memory_mimalloc_directory "")
    if(TARGET UniMemory::UniMemory)
        get_target_property(memory_imported UniMemory::UniMemory IMPORTED)
        get_target_property(memory_backend UniMemory::UniMemory UNIMEMORY_BACKEND)
        get_target_property(memory_directory UniMemory::UniMemory SOURCE_DIR)
        if(NOT memory_imported AND memory_backend STREQUAL "jemalloc")
            get_directory_property(memory_jemalloc_release DIRECTORY "${memory_directory}"
                DEFINITION UNIMEMORY_JEMALLOC_RELEASE_LIBRARY)
            get_directory_property(memory_jemalloc_debug DIRECTORY "${memory_directory}"
                DEFINITION UNIMEMORY_JEMALLOC_DEBUG_LIBRARY)
        endif()
        if(NOT memory_imported AND memory_backend STREQUAL "mimalloc")
            # The mature mimalloc config publishes its library directory (lib
            # for a native install, share for vcpkg). Both have bin as a sibling.
            get_directory_property(memory_mimalloc_directory DIRECTORY "${memory_directory}"
                DEFINITION MIMALLOC_LIBRARY_DIR)
            if(NOT memory_mimalloc_directory)
                get_directory_property(memory_mimalloc_include DIRECTORY "${memory_directory}"
                    DEFINITION UNIMEMORY_MIMALLOC_INCLUDE_DIR)
                if(memory_mimalloc_include)
                    get_filename_component(memory_mimalloc_directory
                        "${memory_mimalloc_include}/../lib" ABSOLUTE)
                endif()
            endif()
        endif()
    endif()
    foreach(configuration IN LISTS configurations)
        string(TOUPPER "${configuration}" upper_configuration)
        set(locations "")
        foreach(target IN LISTS imported_libraries)
            # LOCATION_<CONFIG> applies CMake's imported configuration maps.
            # Read it only for imported targets, never for source targets.
            get_target_property(location ${target} LOCATION_${upper_configuration})
            list(APPEND locations "${location}")
        endforeach()
        # UniMemory 0.0.1 maps non-Debug configurations to Release and also uses
        # Release for Debug when no separate debug library was discovered.
        if(upper_configuration STREQUAL "DEBUG" AND memory_jemalloc_debug)
            list(APPEND locations "${memory_jemalloc_debug}")
        else()
            list(APPEND locations "${memory_jemalloc_release}")
        endif()
        set(library_directories "")
        foreach(location IN LISTS locations)
            if(NOT location OR NOT IS_ABSOLUTE "${location}")
                continue()
            endif()
            get_filename_component(library_directory "${location}" DIRECTORY)
            list(APPEND library_directories "${library_directory}")
        endforeach()
        if(memory_mimalloc_directory)
            get_filename_component(memory_mimalloc_prefix "${memory_mimalloc_directory}/.." ABSOLUTE)
            file(GLOB memory_mimalloc_debug_dlls "${memory_mimalloc_prefix}/debug/bin/mimalloc*.dll")
            if(upper_configuration STREQUAL "DEBUG" AND memory_mimalloc_debug_dlls)
                list(APPEND library_directories "${memory_mimalloc_prefix}/debug/lib")
            else()
                list(APPEND library_directories "${memory_mimalloc_directory}")
            endif()
        endif()
        foreach(library_directory IN LISTS library_directories)
            get_filename_component(binary_directory "${library_directory}/../bin" ABSOLUTE)
            foreach(runtime_directory IN ITEMS "${library_directory}" "${binary_directory}")
                if(CMAKE_CONFIGURATION_TYPES)
                    list(APPEND directories "$<$<CONFIG:${configuration}>:${runtime_directory}>")
                else()
                    list(APPEND directories "${runtime_directory}")
                endif()
                file(GLOB dependency_licenses
                    "${runtime_directory}/../share/*/copyright"
                    "${runtime_directory}/../../share/*/copyright")
                list(APPEND licenses ${dependency_licenses})
            endforeach()
        endforeach()
    endforeach()
    if(VCPKG_INSTALLED_DIR AND VCPKG_TARGET_TRIPLET)
        list(APPEND directories
            "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}$<$<CONFIG:Debug>:/debug>/bin")
        file(GLOB dependency_licenses "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}/share/*/copyright")
        list(APPEND licenses ${dependency_licenses})
    endif()
    list(REMOVE_DUPLICATES directories)
    list(REMOVE_DUPLICATES licenses)
    set_property(GLOBAL PROPERTY MCP_RUNTIME_SEARCH_DIRECTORIES "${directories}")
    set_property(GLOBAL PROPERTY MCP_RUNTIME_DEPENDENCY_LICENSES "${licenses}")
    set(${output} "${directories}" PARENT_SCOPE)
endfunction()
