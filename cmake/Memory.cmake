include_guard(GLOBAL)

# Read the fixed profile before project() so vcpkg selects only its native SDK.
function(mcp_configure_memory_profile)
    if(TARGET UniMemory::UniMemory)
        get_target_property(kind UniMemory::UniMemory TYPE)
        get_target_property(version UniMemory::UniMemory UNIMEMORY_VERSION)
        if(NOT version)
            get_target_property(version UniMemory::UniMemory VERSION)
        endif()
        if(NOT version AND DEFINED UniMemory_VERSION)
            set(version "${UniMemory_VERSION}")
        endif()
        if(NOT kind STREQUAL "INTERFACE_LIBRARY" OR
           NOT version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$" OR
           version VERSION_LESS 0.0.1 OR NOT version VERSION_LESS 0.1.0)
            message(FATAL_ERROR "MCP requires UniMemory >= 0.0.1 and < 0.1.0 "
                "as a fixed-profile header-only INTERFACE target; found '${version}' / '${kind}'")
        endif()
        foreach(property IN ITEMS BACKEND STATISTICS CHECKS_POLICY)
            get_target_property(value UniMemory::UniMemory UNIMEMORY_${property})
            if(property STREQUAL "BACKEND")
                set(variable UNIMEMORY_BACKEND)
                set(pattern "^(standard|mimalloc|jemalloc)$")
                set(type STRING)
            elseif(property STREQUAL "STATISTICS")
                set(variable UNIMEMORY_STATISTICS)
                set(pattern "^(ON|OFF)$")
                set(type BOOL)
            else()
                set(variable UNIMEMORY_CHECKS)
                set(pattern "^(AUTO|ON|OFF)$")
                set(type STRING)
            endif()
            if(NOT value MATCHES "${pattern}")
                message(FATAL_ERROR "MCP requires UniMemory fixed-profile metadata: ${property}")
            endif()
            if(DEFINED ${variable} AND NOT "${${variable}}" STREQUAL "${value}")
                message(FATAL_ERROR "MCP ${variable} conflicts with the host UniMemory profile")
            endif()
            set(${variable} "${value}" CACHE ${type} "Inherited UniMemory ${property}")
            set(${variable} "${value}" PARENT_SCOPE)
        endforeach()
    else()
        set(UNIMEMORY_BACKEND standard CACHE STRING "One allocation backend: standard/mimalloc/jemalloc")
        set(UNIMEMORY_STATISTICS OFF CACHE BOOL "UniMemory per-context Basic statistics support")
        set(UNIMEMORY_CHECKS AUTO CACHE STRING "Allocation preconditions: AUTO/ON/OFF")
    endif()
    set_property(CACHE UNIMEMORY_BACKEND PROPERTY STRINGS standard mimalloc jemalloc)
    set_property(CACHE UNIMEMORY_CHECKS PROPERTY STRINGS AUTO ON OFF)
    if(NOT UNIMEMORY_BACKEND MATCHES "^(standard|mimalloc|jemalloc)$" OR
       NOT UNIMEMORY_STATISTICS MATCHES "^(ON|OFF)$" OR
       NOT UNIMEMORY_CHECKS MATCHES "^(AUTO|ON|OFF)$")
        message(FATAL_ERROR "Invalid UniMemory build profile; select backend, ON/OFF statistics and AUTO/ON/OFF checks")
    endif()
endfunction()

function(mcp_add_memory)
    if(NOT TARGET UniMemory::UniMemory)
        find_package(UniMemory 0.0.1 CONFIG QUIET)
    endif()
    if(NOT TARGET UniMemory::UniMemory)
        set(UNIMEMORY_BUILD_TESTS OFF CACHE BOOL "Build the selected memory backend tests")
        set(UNIMEMORY_BUILD_EXAMPLES OFF CACHE BOOL "Build upstream memory examples")
        # Reuse upstream sanitizer-specific fixtures and runtime compatibility.
        set(UNIMEMORY_SANITIZER "${MCP_SANITIZER}" CACHE STRING "Sanitizer inherited from MCP" FORCE)
        set(UNIMEMORY_SANITIZER "${MCP_SANITIZER}")
        if(WIN32)
            # Schedule staging inside the target-owning directory without
            # modifying the byte-identical upstream CMake source.
            set(_mcp_memory_previous_project_include "${CMAKE_PROJECT_UniMemory_INCLUDE}")
            set(CMAKE_PROJECT_UniMemory_INCLUDE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/MemoryRuntime.cmake")
        endif()
        add_subdirectory("${MCP_UNIMEMORY_SOURCE_DIR}"
            "${CMAKE_CURRENT_BINARY_DIR}/external/unimemory")
    endif()
endfunction()
