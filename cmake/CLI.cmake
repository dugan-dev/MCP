add_library(lib_cli_impl STATIC cli/mcp/main.cpp)
set_target_properties(lib_cli_impl PROPERTIES OUTPUT_NAME MCP_cli_impl FOLDER "Libraries")
target_link_libraries(lib_cli_impl PRIVATE MCP::MCP Boost::process)
target_compile_features(lib_cli_impl PRIVATE cxx_std_20)
add_executable(exe_cli cli/main.cpp)
set_target_properties(exe_cli PROPERTIES OUTPUT_NAME mcp FOLDER "Programs")
target_link_libraries(exe_cli PRIVATE lib_cli_impl)
target_compile_definitions(exe_cli PRIVATE MCP_VERSION="${PROJECT_VERSION}")
foreach(target IN ITEMS lib_cli_impl exe_cli)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /permissive- /utf-8)
        target_compile_definitions(${target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN _WIN32_WINNT=0x0601)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
    endif()
endforeach()
if(MINGW)
    target_link_options(exe_cli PRIVATE -municode)
endif()
if(UNIX AND NOT DEFINED CMAKE_INSTALL_RPATH)
    if(APPLE)
        set(cli_origin "@loader_path")
    else()
        set(cli_origin "$ORIGIN")
    endif()
    set_property(TARGET exe_cli PROPERTY INSTALL_RPATH "${cli_origin}/../${CMAKE_INSTALL_LIBDIR}")
endif()
install(TARGETS exe_cli RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
